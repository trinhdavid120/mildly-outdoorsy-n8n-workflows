# Copy to .env and fill in as needed. NOTHING here is required for the offline
# demo (`python run.py --source seed --provider dryrun`).

# --- Live scraping (Playwright) ---------------------------------------
SCRAPER_HEADLESS=1                 # set 0 to watch the browser while debugging blocks
SCRAPER_PROXY=                     # http://user:pass@host:port  (residential/rotating proxy beats Etsy/Amazon blocks)
SCRAPER_SLOWMO_MS=0                # add per-action delay to look more human
PLAYWRIGHT_CHROMIUM_PATH=          # optional explicit Chromium path; auto-detects /opt/pw-browsers/chromium

# --- Image generation (wire ONE later; dryrun needs none) -------------
FAL_KEY=                           # fal.ai — matches the shop's existing fal stack
FAL_MODEL=fal-ai/flux/schnell
OPENAI_API_KEY=                    # OpenAI Images (gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1
